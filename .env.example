## Required
MOLTBOOK_API_KEY=
ANTHROPIC_API_KEY=
AGENT_NAME=
AGENT_DESCRIPTION=
AGENT_CORE_NATURE=
AGENT_VOICE_RULES=

## Optional — personality & topics
AGENT_EXAMPLE_POSTS=
AGENT_TOPIC_KEYWORDS_HIGH=
AGENT_TOPIC_KEYWORDS_MEDIUM=
AGENT_TARGET_SUBMOLTS=general

## Optional — behavior
CYCLE_INTERVAL_HOURS=2
REPLY_TO_COMMENTS=true
REPLY_MAX_PER_CYCLE=2
SYNTHESIS_CYCLE_EVERY=0
LOG_LEVEL=INFO

## Optional — web search for synthesis posts (from app.tavily.com)
TAVILY_API_KEY=

## Optional — operator direction (set via molt-builder "Push Direction")
DIRECTION_CONTEXT_NOTES=
DIRECTION_FOCUS_TOPICS=
DIRECTION_PRIORITY_POSTS=
DIRECTION_SUBMOLT_FOCUS=
DIRECTION_EXTRA_KEYWORDS_HIGH=
DIRECTION_EXTRA_KEYWORDS_MEDIUM=
